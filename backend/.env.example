# =========================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - NEXUS GAMES FASTAPI
# =========================================================================
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development

# Configuración Base de Datos SQL Relacional (SQLite o MySQL)
DATABASE_URL=sqlite:///./database/database.sqlite
# Ejemplo para MySQL:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/nexus_games
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nexus_games

# Clave Secreta y Algoritmo JWT
JWT_SECRET=tu_clave_secreta_jwt_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Orígenes
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Inteligencia Artificial & Chatbot (Quinto Avance)
AI_PROVIDER=local_fallback
AI_API_KEY=tu_api_key_de_ia_aqui
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-3.5-turbo

