# =========================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - NEXUS GAMES (PostgreSQL)
# Copia este archivo como .env y completa los valores
# =========================================================================
PORT=5000
HOST=127.0.0.1
ENVIRONMENT=development

# -------------------------------------------------------------------------
# CONFIGURACIÓN BASE DE DATOS PostgreSQL
# -------------------------------------------------------------------------
# Opción 1: URL de conexión completa (tiene prioridad sobre las variables individuales)
DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/nexus_games

# Opción 2: Variables individuales (se usan si DATABASE_URL no está definida)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password
DB_NAME=nexus_games

# SSL: Poner 'true' en producción (Railway, Supabase, Neon, Render, etc.)
DB_SSL=false

# -------------------------------------------------------------------------
# AUTENTICACIÓN JWT
# -------------------------------------------------------------------------
JWT_SECRET=tu_clave_secreta_jwt_aqui_minimo_32_caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -------------------------------------------------------------------------
# CORS
# -------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -------------------------------------------------------------------------
# INTELIGENCIA ARTIFICIAL & CHATBOT (Quinto Avance)
# -------------------------------------------------------------------------
AI_PROVIDER=local_fallback
AI_API_KEY=tu_api_key_de_ia_aqui
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-3.5-turbo
